# Copy to .env and fill in. .env is gitignored.
# Non-secret defaults (ports, provider names) may have values here.
# Anything credential-shaped must stay empty, even a local one — the format
# belongs in a comment so a real connection string never lands on the line.

# --- Database ---
# Local Homebrew Postgres trusts the local user, so there is no password:
#   postgres://YOUR_MAC_USER@localhost:5432/collection_manager
# Hosted: postgres://USER:PASSWORD@HOST:5432/collection_manager
DATABASE_URL=

# --- Speech to text ---
# Only one provider is needed. Chosen by measured entity accuracy, not price.
STT_PROVIDER=
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# --- Intent extraction ---
# The model only extracts the spoken string and quantity. It never names cards.
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# For local mode (Ollama / llama.cpp)
LLM_BASE_URL=
LLM_MODEL=

# --- Archidekt ---
# Prefer a token over a password. Never logged, never committed.
ARCHIDEKT_USER_ID=
ARCHIDEKT_TOKEN=

# --- Scryfall ---
# Descriptive User-Agent is required by their API guidelines.
SCRYFALL_USER_AGENT=

# --- App ---
# Single user, so auth is one shared passphrase.
APP_PASSPHRASE=
PORT=3000
